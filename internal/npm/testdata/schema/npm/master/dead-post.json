{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"advanced_config": {
			"example": "",
			"type": "string"
		},
		"certificate_id": {
			"anyOf": [
				{
					"example": 5,
					"minimum": 0,
					"type": "integer"
				},
				{
					"example": "new",
					"pattern": "^new$",
					"type": "string"
				}
			],
			"description": "Certificate ID",
			"example": 5
		},
		"domain_names": {
			"description": "Domain Names separated by a comma",
			"example": [
				"example.com",
				"www.example.com"
			],
			"items": {
				"pattern": "^[^&| @!#%^();:/\\\\}{=+?<>,~`'\"]+$",
				"type": "string"
			},
			"maxItems": 100,
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		},
		"hsts_enabled": {
			"description": "Is HSTS Enabled",
			"example": true,
			"type": "boolean"
		},
		"hsts_subdomains": {
			"description": "Is HSTS applicable to all subdomains",
			"example": true,
			"type": "boolean"
		},
		"http2_support": {
			"description": "HTTP2 Protocol Support",
			"example": true,
			"type": "boolean"
		},
		"meta": {
			"example": {},
			"type": "object"
		},
		"ssl_forced": {
			"description": "Is SSL Forced",
			"example": true,
			"type": "boolean"
		}
	},
	"required": [
		"domain_names"
	],
	"type": "object"
}
