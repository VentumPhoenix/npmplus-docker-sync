{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"properties": {
					"npmplus_dns_challenge": {
						"const": true,
						"type": "boolean"
					}
				},
				"required": [
					"npmplus_dns_challenge"
				]
			},
			"then": {
				"required": [
					"npmplus_dns_provider"
				]
			}
		},
		{
			"if": {
				"properties": {
					"certificate_id": {
						"const": "new"
					}
				},
				"required": [
					"certificate_id"
				]
			},
			"then": {
				"else": {
					"properties": {
						"domain_names": {
							"description": "Domain Names and IPs for the HTTP challenge, wildcards are not allowed",
							"example": [
								"example.com",
								"192.0.2.1",
								"[2001:db8::1]"
							],
							"items": {
								"maxLength": 253,
								"pattern": "^(([\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+\\.)+[\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+|\\[[0-9a-fA-F:]+\\])$",
								"type": "string"
							},
							"maxItems": 25,
							"minItems": 1,
							"type": "array",
							"uniqueItems": true
						}
					}
				},
				"if": {
					"properties": {
						"npmplus_dns_challenge": {
							"const": true,
							"type": "boolean"
						}
					},
					"required": [
						"npmplus_dns_challenge"
					]
				},
				"then": {
					"properties": {
						"domain_names": {
							"description": "Domain Names for the DNS challenge, wildcards are allowed, IPs are not allowed",
							"example": [
								"example.com",
								"*.example.com"
							],
							"items": {
								"maxLength": 253,
								"pattern": "^(?![0-9.]+$)(\\*\\.)?([\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+\\.)+[\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+$",
								"type": "string"
							},
							"maxItems": 25,
							"minItems": 1,
							"type": "array",
							"uniqueItems": true
						}
					}
				}
			}
		},
		{
			"else": {
				"properties": {
					"forward_host": {
						"minLength": 1
					}
				}
			},
			"if": {
				"properties": {
					"forward_scheme": {
						"const": "empty"
					}
				},
				"required": [
					"forward_scheme"
				]
			}
		},
		{
			"if": {
				"properties": {
					"npmplus_access_list_type": {
						"const": "custom"
					}
				},
				"required": [
					"npmplus_access_list_type"
				]
			},
			"then": {
				"properties": {
					"npmplus_access_list_ids": {
						"minItems": 1
					}
				},
				"required": [
					"npmplus_access_list_ids"
				]
			}
		},
		{
			"if": {
				"properties": {
					"npmplus_mtls_certificate_id": {
						"minimum": 1,
						"type": "integer"
					},
					"npmplus_mtls_verify_client_optional": {
						"const": false,
						"type": "boolean"
					}
				},
				"required": [
					"npmplus_mtls_certificate_id"
				]
			},
			"then": {
				"properties": {
					"ssl_forced": {
						"const": true,
						"type": "boolean"
					}
				}
			}
		}
	],
	"properties": {
		"advanced_config": {
			"default": "",
			"example": "",
			"type": "string"
		},
		"certificate_id": {
			"anyOf": [
				{
					"example": 5,
					"minimum": 0,
					"type": "integer"
				},
				{
					"const": "new",
					"example": "new"
				}
			],
			"default": 0,
			"description": "Certificate ID",
			"example": 5
		},
		"domain_names": {
			"description": "Domain Names array",
			"example": [
				"example.com",
				"www.example.com"
			],
			"items": {
				"maxLength": 253,
				"minLength": 1,
				"pattern": "^(~\\S*|(?!.*:[0-9]+$)[^\\s/]+)$",
				"type": "string"
			},
			"maxItems": 100,
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		},
		"forward_host": {
			"default": "",
			"example": "127.0.0.1",
			"maxLength": 255,
			"pattern": "^[^\\s/]{0,253}(/\\S*)?$",
			"type": "string"
		},
		"forward_port": {
			"default": 0,
			"example": 8080,
			"maximum": 65535,
			"minimum": 0,
			"type": "integer"
		},
		"forward_scheme": {
			"default": "http",
			"enum": [
				"http",
				"https",
				"path",
				"empty",
				"grpc",
				"grpcs"
			],
			"example": "http",
			"type": "string"
		},
		"hsts_enabled": {
			"default": false,
			"description": "Is HSTS Enabled",
			"example": true,
			"type": "boolean"
		},
		"hsts_subdomains": {
			"default": false,
			"description": "Is HSTS applicable to all subdomains",
			"example": true,
			"type": "boolean"
		},
		"locations": {
			"default": [],
			"example": [
				{
					"forward_host": "example.com",
					"forward_port": 80,
					"forward_scheme": "http",
					"npmplus_access_list_ids": [
						1,
						2
					],
					"npmplus_access_list_type": "custom",
					"path": "/app"
				}
			],
			"items": {
				"additionalProperties": false,
				"allOf": [
					{
						"else": {
							"properties": {
								"forward_host": {
									"minLength": 1
								}
							},
							"required": [
								"forward_host"
							]
						},
						"if": {
							"properties": {
								"forward_scheme": {
									"const": "empty"
								}
							},
							"required": [
								"forward_scheme"
							]
						}
					},
					{
						"if": {
							"properties": {
								"npmplus_access_list_type": {
									"const": "custom"
								}
							},
							"required": [
								"npmplus_access_list_type"
							]
						},
						"then": {
							"properties": {
								"npmplus_access_list_ids": {
									"minItems": 1
								}
							},
							"required": [
								"npmplus_access_list_ids"
							]
						}
					}
				],
				"properties": {
					"advanced_config": {
						"default": "",
						"type": "string"
					},
					"forward_host": {
						"default": "",
						"example": "127.0.0.1",
						"maxLength": 255,
						"pattern": "^[^\\s/]{0,253}(/\\S*)?$",
						"type": "string"
					},
					"forward_port": {
						"default": 0,
						"example": 8080,
						"maximum": 65535,
						"minimum": 0,
						"type": "integer"
					},
					"forward_scheme": {
						"default": "http",
						"enum": [
							"http",
							"https",
							"path",
							"empty",
							"grpc",
							"grpcs"
						],
						"example": "http",
						"type": "string"
					},
					"location_type": {
						"default": "",
						"enum": [
							"",
							"@",
							"= ",
							"~ ",
							"~* ",
							"^~ "
						],
						"type": "string"
					},
					"npmplus_access_list_ids": {
						"default": [],
						"items": {
							"minimum": 1,
							"type": "integer"
						},
						"type": "array",
						"uniqueItems": true,
						"writeOnly": true
					},
					"npmplus_access_list_type": {
						"default": "global",
						"enum": [
							"global",
							"public",
							"custom"
						],
						"type": "string"
					},
					"npmplus_auth_request": {
						"default": "none",
						"enum": [
							"none",
							"anubis",
							"tinyauth",
							"oauth2proxy",
							"voidauth",
							"authelia",
							"authentik",
							"authentik-send-basic-auth"
						],
						"example": "none",
						"type": "string"
					},
					"npmplus_auth_request_upstream": {
						"default": "",
						"example": "",
						"maxLength": 255,
						"pattern": "^(https?://(([^\\s/:]+|\\[[a-fA-F0-9:]+\\]):[0-9]+|cu_[^\\s/:]+))?$",
						"type": "string"
					},
					"npmplus_crowdsec_appsec": {
						"default": false,
						"description": "Disable Crowdsec Appsec",
						"example": false,
						"type": "boolean"
					},
					"npmplus_enabled": {
						"default": true,
						"description": "Is Enabled",
						"example": false,
						"type": "boolean"
					},
					"npmplus_fancyindex": {
						"default": false,
						"description": "Enable fancyindex",
						"example": false,
						"type": "boolean"
					},
					"npmplus_noindex": {
						"default": false,
						"description": "Send noindex header and block some user agents",
						"example": false,
						"type": "boolean"
					},
					"npmplus_proxy_request_buffering": {
						"default": false,
						"description": "Disable Request Buffering",
						"example": false,
						"type": "boolean"
					},
					"npmplus_proxy_response_buffering": {
						"default": false,
						"description": "Disable Response Buffering",
						"example": false,
						"type": "boolean"
					},
					"npmplus_upstream_compression": {
						"default": false,
						"description": "Enable compression by upstream",
						"example": false,
						"type": "boolean"
					},
					"npmplus_x_frame_options": {
						"default": "SAMEORIGIN",
						"enum": [
							"DENY",
							"SAMEORIGIN",
							"upstream",
							"none"
						],
						"example": "DENY",
						"type": "string"
					},
					"path": {
						"maxLength": 255,
						"minLength": 1,
						"pattern": "^\\S+$",
						"type": "string"
					}
				},
				"required": [
					"path"
				],
				"type": "object"
			},
			"type": "array"
		},
		"npmplus_access_list_ids": {
			"default": [],
			"items": {
				"minimum": 1,
				"type": "integer"
			},
			"type": "array",
			"uniqueItems": true,
			"writeOnly": true
		},
		"npmplus_access_list_type": {
			"default": "public",
			"enum": [
				"public",
				"custom"
			],
			"type": "string"
		},
		"npmplus_auth_request": {
			"default": "none",
			"enum": [
				"none",
				"anubis",
				"tinyauth",
				"oauth2proxy",
				"voidauth",
				"authelia",
				"authentik",
				"authentik-send-basic-auth"
			],
			"example": "none",
			"type": "string"
		},
		"npmplus_auth_request_upstream": {
			"default": "",
			"example": "",
			"maxLength": 255,
			"pattern": "^(https?://(([^\\s/:]+|\\[[a-fA-F0-9:]+\\]):[0-9]+|cu_[^\\s/:]+))?$",
			"type": "string"
		},
		"npmplus_crowdsec_appsec": {
			"default": false,
			"description": "Disable Crowdsec Appsec",
			"example": false,
			"type": "boolean"
		},
		"npmplus_directory": {
			"default": "",
			"description": "Directory to group this host in the UI",
			"example": "Production",
			"maxLength": 255,
			"type": "string"
		},
		"npmplus_dns_challenge": {
			"default": false,
			"description": "Use the DNS challenge",
			"example": false,
			"type": "boolean"
		},
		"npmplus_dns_provider": {
			"default": "",
			"description": "DNS provider",
			"example": "cloudflare",
			"maxLength": 255,
			"type": "string"
		},
		"npmplus_dns_provider_credentials": {
			"default": "",
			"description": "DNS provider credentials",
			"example": "dns_cloudflare_api_token=123",
			"type": "string",
			"writeOnly": true
		},
		"npmplus_fancyindex": {
			"default": false,
			"description": "Enable fancyindex",
			"example": false,
			"type": "boolean"
		},
		"npmplus_http3_support": {
			"default": false,
			"description": "HTTP3 Protocol Support",
			"example": true,
			"type": "boolean"
		},
		"npmplus_location_config": {
			"default": "",
			"example": "",
			"type": "string"
		},
		"npmplus_mtls_bypass_auth_request": {
			"default": false,
			"description": "Skip the auth request if the mTLS client verification succeeded",
			"example": false,
			"type": "boolean"
		},
		"npmplus_mtls_certificate_id": {
			"default": 0,
			"description": "mTLS Certificate ID",
			"example": 0,
			"minimum": 0,
			"type": "integer"
		},
		"npmplus_mtls_verify_client_optional": {
			"default": false,
			"description": "Make the mTLS client verification optional",
			"example": false,
			"type": "boolean"
		},
		"npmplus_noindex": {
			"default": false,
			"description": "Send noindex header and block some user agents",
			"example": false,
			"type": "boolean"
		},
		"npmplus_propagation_seconds": {
			"default": 0,
			"description": "DNS propagation seconds, 0 uses the default of the DNS plugin",
			"example": 0,
			"maximum": 7200,
			"minimum": 0,
			"type": "integer"
		},
		"npmplus_proxy_request_buffering": {
			"default": false,
			"description": "Disable Request Buffering",
			"example": false,
			"type": "boolean"
		},
		"npmplus_proxy_response_buffering": {
			"default": false,
			"description": "Disable Response Buffering",
			"example": false,
			"type": "boolean"
		},
		"npmplus_reuse_key": {
			"default": false,
			"description": "Reuse the private key on renewal",
			"example": false,
			"type": "boolean"
		},
		"npmplus_upstream_compression": {
			"default": false,
			"description": "Enable compression by upstream",
			"example": false,
			"type": "boolean"
		},
		"npmplus_x_frame_options": {
			"default": "SAMEORIGIN",
			"enum": [
				"DENY",
				"SAMEORIGIN",
				"upstream",
				"none"
			],
			"example": "DENY",
			"type": "string"
		},
		"ssl_forced": {
			"default": false,
			"description": "Is SSL Forced",
			"example": true,
			"type": "boolean"
		}
	},
	"required": [
		"domain_names",
		"forward_host"
	],
	"type": "object"
}
