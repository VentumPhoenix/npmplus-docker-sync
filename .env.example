# Copy to .env and adjust. Never commit the real file.

# --- required -------------------------------------------------------------
NPM_URL=http://npm:81
NPM_IDENTITY=admin@example.com
# Prefer NPM_SECRET_FILE (Docker secret) over an inline password:
NPM_SECRET=changeme
# NPM_SECRET_FILE=/run/secrets/npm_password

# API dialect. "auto" probes the server once at startup; pin it to npmplus or
# npm if the detection ever guesses wrong. The two forks reject each other's
# request payloads outright (400 "data must NOT have additional properties").
# NPM_FLAVOUR=auto

# --- docker endpoint ------------------------------------------------------
# Recommended: a filtered socket proxy instead of the raw socket.
DOCKER_HOST=tcp://docker-socket-proxy:2375
# DOCKER_HOST=unix:///var/run/docker.sock
# Host docker group id, only needed for docker-compose.simple.yml:
# DOCKER_GID=988

# Any variable can also be read from a file (Docker/Podman secrets) by adding
# _FILE to its name, e.g. NPM_PASSWORD_FILE or NPM_PROXY_AUTH_REQUEST_UPSTREAM_FILE.

# --- routing --------------------------------------------------------------
# Upstreams default to the container IP, taken from the network NPM lives on.
# With NPM_NETWORK set, a container that is not attached to it is skipped with
# a warning instead of being pointed at an address NPM cannot reach.
NPM_NETWORK=npm
RESOLVE_CONTAINER_IP=true
# NPM_NETWORK_STRICT=false   # restore the old fall-through behaviour
# Limit the managed resource types (default: all four):
# SYNC_KINDS=proxy,redirect,stream,404
# Name of the NPM container; its networks are used when NPM_NETWORK is unset.
# NPM_CONTAINER_NAME=npmplus
# Order for picking a container port when several are exposed:
# NPM_PORT_PREFERENCE=80,8080,3000,8000,443

# --- behaviour ------------------------------------------------------------
LABEL_PREFIX=npm
DEBOUNCE_INTERVAL=3s
DEBOUNCE_MAX_WAIT=30s
RESYNC_INTERVAL=5m
DELETE_ORPHANS=true
ADOPT_EXISTING=true
DRY_RUN=false
# Manage every container that carries npm.* labels (npm.enable=false opts out).
# Set to false to require npm.enable=true, as in v1.0.0-beta.2 and earlier.
# NPM_EXPOSED_BY_DEFAULT=true
# Skip a resource whose labels contain an unknown field instead of warning:
# STRICT_LABELS=false
# Take over hosts created by Redth/npm-docker-sync (see docs/MIGRATION.md):
# MIGRATE_FROM_REDTH=false

# --- deletion safeguards ---------------------------------------------------
# What happens to the hosts of a container that is stopped but still exists:
# disable (default), keep or delete.
NPM_ON_STOP=disable
# A restart or a recreate inside this window changes nothing at all.
NPM_STOP_GRACE=1m
# Largest share of the managed resources one run may delete ("0.5", "50%",
# "off"). A run that would delete all of them is always refused.
DELETE_GUARD=0.5
# ... but only from this many deletions upwards, so small setups stay usable.
# DELETE_GUARD_MIN=3
# Several sync instances against one NPM: each one only touches its own hosts.
# Defaults to the Docker daemon id.
# SYNC_INSTANCE_ID=

# --- certificates ---------------------------------------------------------
# "auto" attaches the best matching certificate: exact before wildcard, never
# an expired one or an NPMplus client CA.
NPM_DEFAULT_CERTIFICATE=auto
# When no single certificate covers every domain: primary (default) or none.
# NPM_CERTIFICATE_PARTIAL=primary
# Request a Let's Encrypt certificate when nothing matches (rate limits!):
# NPM_CERTIFICATE_AUTO_CREATE=false
# How often to look for certificates created in the NPM UI:
# CERTIFICATE_POLL_INTERVAL=1m

# --- field defaults -------------------------------------------------------
# Every label field has an environment default: NPM_<KIND>_<FIELD> for one
# resource type, NPM_DEFAULT_<FIELD> for all of them. Labels on a container
# always win. The full list is in docs/FIELDS.md.
# NPM_PROXY_SSL_FORCE=true
# NPM_PROXY_WEBSOCKETS=true
# NPM_PROXY_HTTP3=true
# NPM_PROXY_AUTH_REQUEST=none
# NPM_STREAM_UDP=false

# --- observability --------------------------------------------------------
# Defaults: LOG_LEVEL=info, LOG_FORMAT=text, HEALTH_ADDR unset (endpoints off).
# The values below are what the bundled compose file uses, not the defaults.
LOG_LEVEL=info
LOG_FORMAT=json
# Serves /healthz, /readyz, /status and /metrics. Leave it out to disable them;
# the container HEALTHCHECK then passes without checking anything.
HEALTH_ADDR=:8080
# Mirror full API request bodies into the debug log when chasing a 400.
# Credential-looking values are redacted, host names and nginx config are not.
# LOG_PAYLOADS=false
