# Copy to .env and fill in. Never commit the real file.

# Domain of the NPM admin UI; the tool creates its proxy host.
NPM_UI_DOMAIN=npm.example.com
# First admin account. The tool logs in with it, so after changing the password
# in the UI, change it here too.
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change-me-to-something-long

# Group id of the Docker socket: getent group docker | cut -d: -f3
DOCKER_GID=988
# TZ=Europe/Berlin
