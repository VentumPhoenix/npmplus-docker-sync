# Copy to .env and fill in. Never commit the real file: chmod 600 .env

# --- required ----------------------------------------------------------------
# Domain of the NPMplus admin UI; the tool creates its proxy host.
NPM_UI_DOMAIN=npm.example.com
# Let's Encrypt account e-mail.
ACME_EMAIL=you@example.com
# First admin account. The tool logs in with it and reads the password from
# secrets/npm_password.txt (see compose.yaml) - after changing the password in
# the UI, update that file.
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change-me-to-something-long
# Shared key between NPMplus' bouncer and CrowdSec: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=
# Group id of the Docker socket: getent group docker | cut -d: -f3
DOCKER_GID=988

# --- optional ----------------------------------------------------------------
# Only log what would change, write nothing:
# DRY_RUN=true
# TZ=Europe/Berlin
# CrowdSec console (also uncomment ENROLL_KEY in compose.yaml):
# CROWDSEC_ENROLL_KEY=

# Networks: the first three octets of each /24, and the Linux bridge names the
# firewall uses. Change them only when they collide with something else.
# NPM_NET_PREFIX=172.30.0
# SOCKPRX_NET_PREFIX=172.31.0
# NPM_BRIDGE=br-npm
# SOCKPRX_BRIDGE=br-sockprx
