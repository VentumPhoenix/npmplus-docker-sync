# Copy to .env and fill in. Never commit the real file: chmod 600 .env

# Admin API of your proxy manager, as seen from the shared network:
#   NPM      http://<container-name>:81
#   NPMplus  https://<container-name>:81  (self-signed: set the next line true)
NPM_URL=http://npm:81
# NPM_INSECURE_SKIP_VERIFY=true

# An NPM account with permission to manage hosts.
NPM_IDENTITY=admin@example.com
NPM_SECRET=your-npm-password

# The Docker network NPM shares with your apps.
NPM_NETWORK=npm

# Starts as a dry run: check `docker compose logs`, then set this to false.
DRY_RUN=true
